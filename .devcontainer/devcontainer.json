// For format details, see https://aka.ms/devcontainer.json. For config options, see the
{
    "name": "k8s-testbed",
    "build": {
        "dockerfile": "Dockerfile"
    },
    // root-level setup is lost on rebuild, so redo it; safe to rerun by hand too
    "postCreateCommand": "just setup",
    // connect only after setup, so the server and its terminals start with the KVM group it
    // may add; groups are fixed per process, only a container restart refreshes them
    "waitFor": "postCreateCommand",
    // KVM if a probe container can open it, else /dev/null; vm.sh falls back to TCG then.
    // --device, unlike a bind mount, also gets the device past rootful Docker's device cgroup.
    "initializeCommand": [
        "sh",
        "${localWorkspaceFolder}/.devcontainer/kvm-link.sh"
    ],
    "runArgs": [
        "--device=${localWorkspaceFolder}/.local/testbed/host/kvm:/dev/kvm"
    ],
    // same defaults as testbed/justfile, so a plain kubectl and docker work in terminals too;
    // PATH adds krew's bin last, so its plugins can't shadow system tools
    "remoteEnv": {
        "KUBECONFIG": "${containerWorkspaceFolder}/.local/testbed/vm/cluster/kubeconfig",
        "DOCKER_HOST": "tcp://127.0.0.1:2375",
        "KREW_ROOT": "${containerWorkspaceFolder}/.local/testbed/krew",
        "PATH": "${containerEnv:PATH}:${containerWorkspaceFolder}/.local/testbed/krew/bin"
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "streetsidesoftware.code-spell-checker",
                "eamodio.gitlens",
                "github.vscode-pull-request-github"
            ],
            "settings": {
                "gitlens.gitkraken.mcp.autoEnabled": false,
                "chat.defaultConfiguration": {
                    "approvals": "assisted"
                }
                // never mind sandbox, doesn't work in podman containers
                // "chat.agent.sandbox.enabled": "on"
            }
        }
    }
}